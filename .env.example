# Copy to .env, fill in real values, and `netlify dev` should work first try.
# .env is gitignored; .env.example is the only env file tracked.
#
# IMPORTANT (git worktrees): if this repo is checked out as a git worktree
# (e.g. under .claude/worktrees/<name>), `netlify dev` can resolve its site
# root to the MAIN worktree instead of this one and silently load a
# DIFFERENT .env from there. If secrets look right here but requests still
# 401/403, run `npm run dev` (pins --dir/--functions explicitly) instead of
# a bare `netlify dev`, and confirm which directory's .env actually loaded.

# ---- Anthropic (classify.js, read-pulse.js: pulse-preview, pulse-rescan,
#      classify-brand, generate-report-background) ----
# Required. Get one at https://console.anthropic.com/settings/keys
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=

# ---- Cloudflare Turnstile (pulse-preview.js abuse gate) ----
# Required for the honeypot/bot-check gate in front of the expensive path.
# For LOCAL TESTING ONLY, Cloudflare publishes an "always passes" test pair —
# use both together, never mix a test key with a real secret or vice versa:
#   TURNSTILE_SITE=1x00000000000000000000AA
#   TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Real values: https://dash.cloudflare.com/ -> Turnstile
TURNSTILE_SECRET=
# TURNSTILE_SITE is not read by any Netlify function — it's a public site
# key baked into trend-pulse.html's Turnstile widget markup client-side.
# Listed here so both halves of the pair live in one place; update the
# hardcoded data-sitekey in trend-pulse.html when you change this.
TURNSTILE_SITE=

# ---- Rate limiting (pulse-preview.js) ----
# Required. Any random string — salts the per-IP hash used for the 5/day
# rate limit key so raw IPs are never stored. Generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
IP_SALT=

# ---- Google Apps Script bridge (crawl-trends.js, generate-report-background.js,
#      lead-followup-check.js) ----
# Required. The deployed Apps Script /exec URL and its shared secret
# (apps-script/Code.gs's SECRET script property must match this exactly).
# Every Apps Script edit needs a NEW deployment — the /exec URL changes,
# so this value changes too whenever apps-script/Code.gs is redeployed.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# ---- Optional: fallback email copy (lib/lead-store.js) ----
# The lead-facing email sent by lead-followup-check.js when a report hasn't
# delivered within 10 minutes. If unset, falls back to a literal placeholder
# string that visibly reads as "not real copy" rather than something that
# could pass as a real email if it ever shipped un-set.
FALLBACK_EMAIL_BODY=

# ---- Optional: Blobs store namespacing (pool.js, entity-cache.js,
#      crawl-trends.js, get-trends.js) ----
# Defaults to "trends" if unset. Only needed to point a staging deploy at a
# separate Blobs store so it can never write into production's cache.
BLOBS_STORE_NAME=

# ---- Source adapters (lib/sources/github.js, lib/sources/x-list.js) ----
# Used by the category trend crawl (crawl-trends.js), not by any Trend
# Pulse request-path endpoint directly.
GITHUB_TOKEN=
X_BEARER_TOKEN=

# ---- Netlify-provided, do not set manually ----
# process.env.URL is auto-injected by Netlify (both in production and via
# `netlify dev`, which sets it to http://localhost:8888) and is read by
# lead-submit.js to invoke generate-report-background.js internally.
